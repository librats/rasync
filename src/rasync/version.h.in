#pragma once

// Generated by CMake from version.h.in into the build tree — do not edit, and do
// not commit a version.h next to this file: an on-disk copy would shadow the
// generated one for every source that sits in this directory.

#define RASYNC_VERSION_MAJOR  @RASYNC_VERSION_MAJOR@
#define RASYNC_VERSION_MINOR  @RASYNC_VERSION_MINOR@
#define RASYNC_VERSION_PATCH  @RASYNC_VERSION_PATCH@
#define RASYNC_VERSION_BUILD  @RASYNC_VERSION_BUILD@
#define RASYNC_VERSION_STRING "@RASYNC_VERSION_STRING@"
#define RASYNC_GIT_DESCRIBE   "@RASYNC_GIT_DESCRIBE@"

namespace rasync {

/// MAJOR.MINOR.PATCH from the newest reachable git tag, then the commit count —
/// so two builds between the same pair of tags still order.
constexpr const char* kVersion = RASYNC_VERSION_STRING;

/// `git describe --tags --always --dirty`, or "unknown" when built without git.
/// The exact tree a binary came from; kVersion alone cannot say "dirty".
constexpr const char* kGitDescribe = RASYNC_GIT_DESCRIBE;

/// librats handshake protocol id. Deliberately *not* derived from the version:
/// it names wire compatibility, so it changes only when the protocol does, and
/// two rasync builds of different versions must still be able to talk.
constexpr const char* kProtocolName = "rasync/1";

} // namespace rasync
